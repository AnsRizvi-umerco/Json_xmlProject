<INVOKE NAME="JSON" SERVICE="pub.json:jsonStringToDocument">
  <COMMENT></COMMENT>

  <!-- nodes -->

<MAP MODE="INPUT">
  <COMMENT></COMMENT>
  <MAPCOPY FROM="jsonString" TO="jsonString"/>
</MAP>

<MAP MODE="OUTPUT">
  <COMMENT></COMMENT>
</MAP>
</INVOKE>

